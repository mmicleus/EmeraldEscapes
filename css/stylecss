:root {
  --green: #173803;  
  --accent: #416100;  
  --leaf: #709a08; 
  --lime: #83c702; 
  --gorse: #bce000;
  --bg: #f7faef;     
  --card: #ffffff;  
  --ink: #173803;  
  --muted: #416100;
